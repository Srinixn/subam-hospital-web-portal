# ─────────────────────────────────────────────
#  Backend Environment Variables
#  Copy this file to .env and fill in the values.
#  DO NOT commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

DB_NAME=subam_hospital

# Session
SESSION_SECRET=change-this-to-a-random-64-char-string

# CORS — comma-separated origins allowed to call the API
# In production, set to your domain(s). In dev, frontend runs on :3000.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Chatbot Configuration ───

# OpenAI API Key (optional — falls back to keyword search if not set)
OPENAI_API_KEY=

# JWT Authentication (for chatbot admin API)
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Emergency phone number
EMERGENCY_PHONE=+91 90922 25481

# Logging
LOG_LEVEL=info

