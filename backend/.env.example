# ─────────────────────────────────────────────
#  Backend Environment Variables
#  Copy this file to .env and fill in the values.
#  DO NOT commit .env to version control.
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=demo_hospital

# Session
SESSION_SECRET=change-this-to-a-random-64-char-string

# CORS — comma-separated origins allowed to call the API
# In production, set to your domain(s). In dev, frontend runs on :3000.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Chatbot Configuration ───

# OpenAI API Key (required for RAG embeddings + LLM answers)
# If not set, the chatbot falls back to keyword-based search.
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Authentication (for chatbot admin API)
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Emergency phone number (displayed in chatbot disclaimer)
EMERGENCY_PHONE=+00 00000 00000

# Logging
LOG_LEVEL=info
