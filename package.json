{
  "name": "demo-hospital",
  "private": true,
  "version": "0.0.0",
  "description": "Demo Hospital Website — Monorepo (Frontend + Admin + Backend)",
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:admin": "npm run build --workspace=admin",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "build": "npm run build --workspace=backend",
    "start": "npm run start --workspace=backend"
  }
}
