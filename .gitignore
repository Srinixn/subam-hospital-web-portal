# ─────────────────────────────────────────────
#  Node Modules
# ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
admin/node_modules/
backend/node_modules/

# ─────────────────────────────────────────────
#  Build Outputs
# ─────────────────────────────────────────────
dist/
frontend/dist/
admin/dist/
backend/dist/

# ─────────────────────────────────────────────
#  Environment Files (NEVER commit secrets)
# ─────────────────────────────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
admin/.env
admin/.env.local
backend/.env
backend/.env.local
backend/.env copy

# User-submitted files (never commit client or patient uploads)
backend/uploads/tickets/*
!backend/uploads/tickets/.gitkeep

# ─────────────────────────────────────────────
#  Logs
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────
#  TypeScript Build Cache
# ─────────────────────────────────────────────
*.tsbuildinfo
frontend/*.tsbuildinfo
backend/*.tsbuildinfo

# ─────────────────────────────────────────────
#  OS Artifacts
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
#  IDE
# ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─────────────────────────────────────────────
Contex
# ─────────────────────────────────────────────
docs

# ─────────────────────────────────────────────
agent rules
# ─────────────────────────────────────────────
.agents